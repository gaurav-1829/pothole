# ==============================================================================
# RoadWatch AI — Environment Configuration Template
# Copy this file to `.env` or `backend/.env` and update the values as needed.
# ==============================================================================

# --- Database Configuration ---
# Path or connection string for SQLite/PostgreSQL
DATABASE_URL=sqlite:///./pothole_reports.db

# --- Server & Network ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI / Computer Vision Model Paths ---
# Optional paths to PyTorch / YOLO weights (*.pt files)
# The backend falls back gracefully to OpenCV contour detection if models are not present
YOLO_MODEL_PATH=models/pothole.pt
YOLO_SEG_MODEL_PATH=models/pothole-seg.pt

# --- External Service API Keys (Backend Proxy Only) ---
# Optional: Set your third-party provider keys here if applicable
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
WEATHER_API_KEY=your_weather_api_key_here

# --- Performance & Concurrency Optimization ---
OPENBLAS_NUM_THREADS=1
