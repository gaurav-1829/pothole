# PotholeWatch Environment Configuration
# Secret keys and local settings

DATABASE_URL=sqlite:///./pothole_reports.db
HOST=0.0.0.0
PORT=8000

# YOLO Model Paths (optional - system falls back gracefully to computer vision pipeline if absent)
YOLO_MODEL_PATH=models/pothole.pt
YOLO_SEG_MODEL_PATH=models/pothole-seg.pt

# Optional External API Keys (backend proxy only, never expose to frontend)
GOOGLE_MAPS_API_KEY=
WEATHER_API_KEY=
OPENBLAS_NUM_THREADS=1
